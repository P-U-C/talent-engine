[Unit]
Description=Cloudflare Tunnel (sponsorships.prezenti.xyz -> talent-engine intake)
After=network-online.target talent-engine-intake.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/cloudflared --config /etc/cloudflared/sponsorships.yml tunnel run
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
